# ggpi: run pi against a local llama.cpp provider, sourced by ~/.myenv
# usage: ggpi <short> [model] [--spec] [--] [messages...]
# no args: list available options
# format: <short> <provider> <alias1,alias2,...> <model-name> <hardware>
# fields are space-separated, hardware is the rest of the line (may contain spaces)
# --spec runs a planning session: appends $GGPI_SPEC_PROMPT (default ~/.pi/agent/SPEC.md)
# personal rules are always appended when found: $GGPI_APPEND_SYSTEM (default <repo-root>/.pi/gg/APPEND_SYSTEM.md)
# repo skills under <repo-root>/skills are loaded when the folder exists
GGPI_PROVIDERS=(
    "m2-qwen3.8    llama-mac-m2   agent-qwen3.8   ggml-org/Qwen3.8-27B-GGUF Mac Studio, M2 Ultra, 192GB"
    "m2-qwen4      llama-mac-m2   agent-qwen4     ggml-org/Qwen3.8-Flash-Next-GGUF Mac Studio, M2 Ultra, 192GB"
    "m2-dsv4       llama-mac-m2   agent-dsv4      ggml-org/DeepSeek-V4-Flash-Vision-Exp-GGUF Mac Studio, M2 Ultra, 192GB"
    "m2-mimo       llama-mac-m2   agent-mimo      ggml-org/MiMo-V2.6-Flash-MOPD-GGUF Mac Studio, M2 Ultra, 192GB"
    "m2-glm        llama-mac-m2   agent-glm       ggml-org/GLM-5.3-Flash-GGUF Mac Studio, M2 Ultra, 192GB"
    "m5-1-qwen4    llama-mac-m5-1 agent-qwen4     ggml-org/Qwen3.8-Flash-Next-GGUF MacBook, M5 Max, 128GB"
    "dgx-mimo      llama-dgx      agent-mimo      ggml-org/MiMo-V2.6-Flash-MOPD-GGUF 2x DGX Spark (RDMA, TP=2)"
    "dgx-glm       llama-dgx      agent-glm       ggml-org/GLM-5.3-Flash-GGUF 2x DGX Spark (RDMA, TP=2)"
    "rtx-dsv4      llama-rtx      agent-dsv4      ggml-org/DeepSeek-V4-Flash-Vision-Exp-GGUF RTX 5090 32GB, DDR5 128GB"
    "rtx-qwen3.8   llama-rtx      agent-qwen3.8   ggml-org/Qwen3.8-27B-GGUF RTX 5090 32GB, DDR5 128GB"
    "rtx-qwen4     llama-rtx      agent-qwen4     ggml-org/Qwen3.8-Flash-Next-GGUF RTX 5090 32GB, DDR5 128GB"
    "rtx-glm       llama-rtx      agent-glm       ggml-org/GLM-5.3-Flash-GGUF RTX 5090 32GB, DDR5 128GB"
    "rtx-flint     llama-rtx      agent-flint     ggml-org/Flint-GGUF RTX 5090 32GB, DDR5 128GB"
    "strix-mimo    llama-strix    agent-mimo      ggml-org/MiMo-V2.6-Flash-MOPD-GGUF 2x Strix Halo (Ethernet, PP=2)"
)

ggpi_list() {
    printf "%-13s %-14s %-15s %-44s %s\n" "SHORT" "PROVIDER" "ALIAS" "MODEL" "HARDWARE"
    local entry short provider model_alias model_name hardware
    for entry in "${GGPI_PROVIDERS[@]}"; do
        read -r short provider model_alias model_name hardware <<< "$entry"
        printf "%-13s %-14s %-15s %-44s %s\n" "$short" "$provider" "$model_alias" "$model_name" "$hardware"
    done
}

_ggpi_slug() {
    echo "$*" | tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9' '-' | cut -c1-48 | sed -e 's/^-*//' -e 's/-*$//'
}

ggpi() {
    local entry short provider model_alias model model_name hardware tab_id spec=0 spec_prefix="" spec_prompt spec_slug
    local repo_root append_system
    local -a sys_args=() skill_args=() spec_args=() _ggpi_args=()
    local arg seen_sep=0

    # consume --spec from the args before the first --
    for arg in "$@"; do
        if (( seen_sep )) || [[ "$arg" == "--" ]]; then
            seen_sep=1
        elif [[ "$arg" == "--spec" ]]; then
            spec=1
            spec_prefix="spec:"
            continue
        fi
        _ggpi_args+=( "$arg" )
    done
    set -- ${_ggpi_args[@]+"${_ggpi_args[@]}"}

    if [[ -z "$1" ]]; then
        echo "Usage: ggpi <short> [model] [--spec] [--] [messages...]"
        echo
        ggpi_list
        echo
        echo "Examples:"
        echo "  ggpi m2-dsv4                          # m2 machine, DeepSeek"
        echo "  ggpi rtx-qwen4 'fix the bug'          # rtx machine, Qwen, with a prompt"
        echo "  ggpi dgx-glm agent-glm 'hi'           # alias is optional before the prompt"
        echo "  ggpi m5-1-qwen4 --spec                # planning session, then dictate the task"
        return 1
    fi

    # find the provider matching the short name
    provider=""; model_alias=""
    for entry in "${GGPI_PROVIDERS[@]}"; do
        [[ "${entry%% *}" == "$1" ]] || continue
        read -r short provider model_alias model_name hardware <<< "$entry"
        break
    done

    if [[ -z "$provider" ]]; then
        echo "ggpi: unknown provider '$1'" >&2
        echo >&2
        ggpi_list >&2
        return 1
    fi

    # drop the short name
    shift

    # the next arg is a model only if it's valid for this provider; otherwise
    # it (and the rest) are the prompt. default to the provider's first model.
    model=""
    if [[ -n "${1:-}" && ",${model_alias}," == *",${1},"* ]]; then
        model=$1
        shift
    fi
    [[ -z "$model" ]] && model=$(echo "$model_alias" | cut -d',' -f1)

    echo "ggpi: $provider: $model_name [$hardware]" >&2

    # append the personal rules on top of the main system prompt (.pi/gg is not auto-discovered)
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
    append_system=${GGPI_APPEND_SYSTEM:-${repo_root:+$repo_root/.pi/gg/APPEND_SYSTEM.md}}
    if [[ -n "$append_system" && -f "$append_system" ]]; then
        sys_args=( --append-system-prompt "$append_system" )
        echo "ggpi: append: ${append_system#$HOME/}" >&2
    fi

    # pi only discovers skills under .pi/skills, so pass the repo's own folder explicitly
    if [[ -n "$repo_root" && -d "$repo_root/skills" ]]; then
        skill_args=( --skill "$repo_root/skills" )
        echo "ggpi: skill: ${repo_root#$HOME/}/skills" >&2
    fi

    # --spec: append the planning prompt and pin the task file for this session
    if (( spec )); then
        spec_prompt=${GGPI_SPEC_PROMPT:-$HOME/.pi/agent/SPEC.md}
        if [[ ! -f "$spec_prompt" ]]; then
            echo "ggpi: spec: no prompt found at $spec_prompt" >&2
            return 1
        fi

        # no task description means no slug - the agent names the task file in the session
        spec_slug=$(_ggpi_slug "$*")
        mkdir -p .pi
        spec_args=( --append-system-prompt "$spec_prompt" )
        if [[ -n "$spec_slug" ]]; then
            export GGPI_TASK_FILE="$PWD/.pi/task-${spec_slug}.md"
            spec_args+=( --name "spec:$spec_slug" )
            echo "ggpi: spec: ${spec_prompt#$HOME/} -> ${GGPI_TASK_FILE#$HOME/}" >&2
        else
            export GGPI_TASK_FILE=
            echo "ggpi: spec: ${spec_prompt#$HOME/} -> .pi/task-<slug>.md, named in session" >&2
        fi
    fi

    # if running under herdr, name the current tab after the provider/model
    if [[ -n "$HERDR_ENV" ]]; then
        tab_id=$(herdr pane current 2>/dev/null | jq -r '.result.pane.tab_id // empty')
        if [[ -n "$tab_id" ]]; then
            herdr tab rename "$tab_id" "$spec_prefix$provider:$model_name" 2>/dev/null
        fi
    fi

    export PI_MODEL_NAME="$model_name"
    export PI_HARDWARE="$hardware"

    pi --offline -nc --provider "$provider" --model "$model" ${sys_args[@]+"${sys_args[@]}"} ${skill_args[@]+"${skill_args[@]}"} ${spec_args[@]+"${spec_args[@]}"} "$@"
}

# kiss: start a KiSS server of the current directory, aimed at one endpoint of
# the fleet, sourced by ~/.myenv
# usage: kiss <short>               the short names of ggpi, with the model they name
#        kiss <endpoint>[/<model>]  an endpoint of kiss.conf, and a model of its own
# no args: list the shorts and the endpoints
# The server reads its configuration from ./server.conf alone, so kiss copies
# kiss.conf there and adds the port it took, the hostname and the key it made.
# The KiSS server of a directory is started once and answers on its own port:
# the manager start-*.sh leaves on $KISS_PORT lists it and stops it again.
# the directory this file is in, which is the directory of the machines it
# sets up: it is sourced as ~/.myenv.llama, a link to it, so a link is followed
# to what it links to before its directory is taken
_kiss_env=${BASH_SOURCE[0]}
while [[ -L $_kiss_env ]]; do
    _kiss_at=$(readlink "$_kiss_env")
    [[ $_kiss_at == /* ]] || _kiss_at=$(dirname "$_kiss_env")/$_kiss_at
    _kiss_env=$_kiss_at
done
KISS_BASE=${KISS_BASE:-$(cd "$(dirname "$_kiss_env")" && pwd)}
unset _kiss_env _kiss_at
KISS_MANAGER_DIR=${KISS_MANAGER_DIR:-$KISS_BASE/kiss-manager}
KISS_CONF=${KISS_CONF:-$KISS_BASE/kiss.conf}
KISS_HOME=${KISS_HOME:-$KISS_BASE}
KISS_PORT_BASE=${KISS_PORT_BASE:-19000}
KISS_HOST=${KISS_HOST:-0.0.0.0}
# the rules every KiSS session of the fleet answers by, written into the
# server.conf of the directory as chat system-prompt: the same file ggpi hands
# to pi as --append-system-prompt
KISS_SYSTEM=${KISS_SYSTEM:-$(cd "$KISS_BASE/../pi" 2> /dev/null && pwd)/SYSTEM.md}

# the endpoint of kiss.conf each provider of ggpi answers with
KISS_ENDPOINTS=(
    "llama-mac-m2   m2"
    "llama-mac-m5-1 m5-1"
    "llama-dgx      dgx-0"
    "llama-rtx      rtx"
    "llama-strix    strix-0"
)

kiss_list() {
    local entry at short provider model model_name hardware endpoint

    printf "%-13s %-11s %-14s %s\n" "SHORT" "ENDPOINT" "MODEL" "HARDWARE"
    for entry in "${GGPI_PROVIDERS[@]}"; do
        read -r short provider model model_name hardware <<< "$entry"
        endpoint=""
        for at in "${KISS_ENDPOINTS[@]}"; do
            [[ "${at%% *}" == "$provider" ]] && endpoint=${at##* } && break
        done
        [[ -n $endpoint ]] || continue
        printf "%-13s %-11s %-14s %s\n" "$short" "$endpoint" "${model%%,*}" "$hardware"
    done

    if [[ -f $KISS_CONF ]]; then
        echo
        echo "every endpoint of ${KISS_CONF#$HOME/}, each answered to by kiss <endpoint>/<model>:"
        awk '$2 == "endpoints" && $3 == "url" { printf "  %-11s %s\n", $4, $5 }' "$KISS_CONF"
        awk '$2 == "mcp" && $3 == "url" { printf "  %-11s %s\n", $4, $5 }' "$KISS_CONF"
    fi
}

kiss() {
    local entry short="" provider="" model_alias="" model_name="" hardware="" endpoint="" model=""
    local -a kiss_args=()

    if [[ -z "${1:-}" || $1 == "-h" || $1 == "--help" ]]; then
        kiss_list
        echo
        echo "Examples:"
        echo "  kiss rtx-qwen4              # the machine and the model of ggpi's rtx-qwen4"
        echo "  kiss m5-0                   # an endpoint of kiss.conf, its own first model"
        echo "  kiss dgx-0/agent-glm        # an endpoint and a model of its own"
        return 1
    fi

    # a ggpi short names the machine, the model and the hardware at once
    for entry in "${GGPI_PROVIDERS[@]}"; do
        [[ "${entry%% *}" == "$1" ]] || continue
        read -r short provider model_alias model_name hardware <<< "$entry"
        break
    done

    if [[ -n $provider ]]; then
        for entry in "${KISS_ENDPOINTS[@]}"; do
            [[ "${entry%% *}" == "$provider" ]] && endpoint=${entry##* } && break
        done
        model=${model_alias%%,*}
    elif [[ $1 == */* ]]; then
        endpoint=${1%%/*}
        model=${1##*/}
    elif [[ -f $KISS_CONF ]] && grep -q "^set endpoints url $1 " "$KISS_CONF"; then
        endpoint=$1
    else
        echo "kiss: unknown name '$1'" >&2
        echo >&2
        kiss_list >&2
        return 1
    fi

    if [[ -z $endpoint ]]; then
        echo "kiss: no endpoint of kiss.conf answers to the provider '$provider'" >&2
        echo >&2
        kiss_list >&2
        return 1
    fi

    if [[ ! -x $KISS_MANAGER_DIR/kiss-start.sh ]]; then
        echo "kiss: no kiss-start.sh in $KISS_MANAGER_DIR: run ./setup-<machine>.sh" >&2
        return 1
    fi
    if [[ ! -f $KISS_CONF ]]; then
        echo "kiss: no kiss.conf at $KISS_CONF" >&2
        return 1
    fi

    echo "kiss: $endpoint${model:+/$model}${hardware:+ [$hardware]}" >&2

    # a hostname may not carry a hyphen: it prefixes the names of the tools
    kiss_args=(--free --host "$KISS_HOST" --name "${endpoint//-/_}" --conf "$KISS_CONF")
    [[ -z $model ]] || kiss_args+=(--model "$endpoint/$model")
    if [[ -f $KISS_SYSTEM ]]; then
        kiss_args+=(--system "$KISS_SYSTEM")
        echo "kiss: system: ${KISS_SYSTEM#$HOME/}" >&2
    else
        echo "kiss: system: none found at $KISS_SYSTEM, the chat keeps the model's own prompt" >&2
    fi
    [[ -z $model_name ]] || export PI_MODEL_NAME="$model_name"
    [[ -z $hardware ]] || export PI_HARDWARE="$hardware"

    # if running under herdr, name the current tab after the endpoint
    if [[ -n "$HERDR_ENV" ]]; then
        local tab_id
        tab_id=$(herdr pane current 2>/dev/null | jq -r '.result.pane.tab_id // empty')
        if [[ -n "$tab_id" ]]; then
            herdr tab rename "$tab_id" "kiss:$endpoint${model:+/$model}" 2>/dev/null
        fi
    fi

    KISS_HOME="$KISS_HOME" KISS_PORT_BASE="$KISS_PORT_BASE" \
        "$KISS_MANAGER_DIR/kiss-start.sh" "${kiss_args[@]}"
}
