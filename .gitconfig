[alias]
    ci = commit
    st = status
    co = checkout
    br = branch
    ro = "!f() { git fetch origin; branch=$(git rev-parse --abbrev-ref HEAD); read -p \"reset '$branch' to origin/$branch? [y/N] \" confirm; if [ \"$confirm\" = \"y\" ]; then git reset --hard origin/$branch; else echo \"cancelled\"; fi; }; f"

[core]
    editor = vim
    pager = delta --color-only

[interactive]
    diffFilter = delta --color-only

[delta]
    minus-style                   = red normal
    minus-non-emph-style          = red normal
    minus-emph-style              = bright-red normal
    minus-empty-line-marker-style = normal normal
    plus-style                    = green normal
    plus-non-emph-style           = green normal
    plus-emph-style               = bright-green normal
    plus-empty-line-marker-style  = normal normal

[merge]
    tool = vimdiff

[color]
    ui = true

[credential]
    helper = store

[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f

[diff]
    tool = kitty
    guitool = kitty.gui

[difftool]
    prompt = false
    trustExitCode = true

[difftool "kitty"]
    cmd = kitty +kitten diff $LOCAL $REMOTE

[difftool "kitty.gui"]
    cmd = kitty kitty +kitten diff $LOCAL $REMOTE

[include]
    path = .gitconfig.local
