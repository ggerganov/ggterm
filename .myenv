#!/bin/bash

# ls colors
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

export EDITOR=vim

# kitten
alias icat="kitty +kitten icat"
#alias diff="kitty +kitten diff"
alias gd="git difftool --no-symlinks --dir-diff"

# home bin
if [ -d ~/bin ]; then
    export PATH=~/bin:$PATH
fi

export HISTCONTROL=erasedups:ignorespace
export HISTSIZE=10000000
export HISTFILESIZE=100000000

PROMPT_COMMAND='printf "\033]0;${PWD}\007"'
#PROMPT_COMMAND='echo "${PWD/#$HOME/~}"'
#PROMPT_COMMAND='echo "\033]0;${PWD/#$HOME/~}\007"'
#PROMPT_COMMAND="printf \"\033]0; $(pwd) \a\"; $PROMPT_COMMAND"

#shopt -s histappend
#PROMPT_COMMAND="history -a; history -r; $PROMPT_COMMAND"

alias mc="$(which mc) -u"

#bindkey "\e[1;3C" forward-word
#bindkey "\e[1;3D" backward-word

source ~/.myenv.local

alias llama-mac="pgrep -f 'ssh -fNL 8013:localhost:8013 ggerganov@gg-studio' || ssh -fNL 8013:localhost:8013 ggerganov@gg-studio"
alias llama-dgx="pgrep -f 'ssh -fNL 8023:localhost:8023 ggml@gg-spark-0'     || ssh -fNL 8023:localhost:8023 ggml@gg-spark-0"

pr2wt() {
    if [[ $# -gt 1 ]]; then
        #./scripts/pr2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        if [[ "$2" == "build" ]]; then
            ./scripts/pr2wt.sh "$1" "cmake -B build -DLLAMA_BUILD_UI=OFF && cmake --build build -j && cd build && bash -l"
        elif [[ "$2" == "debug" ]]; then
            ./scripts/pr2wt.sh "$1" "cmake -B build-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build-debug -j && cd build-debug && bash -l"
        else
            ./scripts/pr2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        fi
    else
        ./scripts/pr2wt.sh "$1" "bash -l"
    fi
}

wc2wt() {
    if [[ $# -gt 1 ]]; then
        #./scripts/wc2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        if [[ "$2" == "build" ]]; then
            ./scripts/wc2wt.sh "$1" "cmake -B build -DLLAMA_BUILD_UI=OFF && cmake --build build -j && cd build && bash -l"
        elif [[ "$2" == "debug" ]]; then
            ./scripts/wc2wt.sh "$1" "cmake -B build-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build-debug -j && cd build-debug && bash -l"
        else
            ./scripts/wc2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        fi
    else
        ./scripts/wc2wt.sh "$1" "bash -l"
    fi
}

# ggpi: run pi against a local llama provider
# usage: ggpi <short> [model] [--spec] [--] [messages...]
# no args: list available options
# format: short:provider:model1,model2,...:model-name
# model-name is a maintained, human-readable label for the model actually served
# by that provider (used for the stderr line and herdr tab naming).
# --spec runs a planning session: appends $GGPI_SPEC_PROMPT (default ~/.pi/agent/SPEC.md,
# symlinked from the ggterm repo) to the system prompt. A task description becomes the
# opening message and pins GGPI_TASK_FILE to .pi/task-<slug>.md; without one the agent
# names the task file in the session.
GGPI_PROVIDERS=(
    "m2-dsv4:llama-mac-m2:agent-dsv4:DeepSeek-V4-Flash-Vision-Exp"
    "m2-mimo:llama-mac-m2:agent-mimo:MiMo-V2.6-Flash-MOPD"
    "m2-glm:llama-mac-m2:agent-glm:GLM-5.3-Flash"
    "m5:llama-mac-m5:agent-dsv4:DeepSeek-V4-Flash-Vision-Exp"
    "dgx-dsv4:llama-dgx:agent-dsv4:DeepSeek-V4-Flash-Vision-Exp"
    "dgx-mimo:llama-dgx:agent-mimo:MiMo-V2.6-Flash-MOPD"
    "dgx-glm:llama-dgx:agent-glm:GLM-5.3-Flash"
    "rtx-dsv4:llama-rtx:agent-dsv4:DeepSeek-V4-Flash-Vision-Exp"
    "rtx-qwen3.8:llama-rtx:agent-qwen3.8:Qwen3.8-27B"
    "rtx-qwen4:llama-rtx:agent-qwen4:Qwen3.8-Flash-Next"
    "rtx-glm:llama-rtx:agent-glm:GLM-5.3-Flash"
    "strix-dsv4:llama-strix:agent-dsv4:DeepSeek-V4-Flash-Vision-Exp"
    "strix-mimo:llama-strix:agent-mimo:MiMo-V2.6-Flash-MOPD"
)

ggpi_list() {
    printf "%-16s %-16s %-12s %s\n" "SHORT" "PROVIDER" "MODELS" "MODEL"
    local entry short rest provider models model_name
    for entry in "${GGPI_PROVIDERS[@]}"; do
        short=${entry%%:*}
        rest=${entry#*:}
        provider=${rest%%:*}
        rest=${rest#*:}
        models=${rest%%:*}
        model_name=${rest#*:}
        printf "%-16s %-16s %-12s %s\n" "$short" "$provider" "$models" "$model_name"
    done
}

_ggpi_slug() {
    echo "$*" | tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cs 'a-z0-9' '-' | cut -c1-48 | sed -e 's/^-*//' -e 's/-*$//'
}

ggpi() {
    local entry short rest provider models model model_name tab_id spec=0 spec_prompt spec_slug
    local -a spec_args=() _ggpi_args=()
    local arg seen_sep=0

    # consume --spec from the args before the first --
    for arg in "$@"; do
        if (( seen_sep )) || [[ "$arg" == "--" ]]; then
            seen_sep=1
        elif [[ "$arg" == "--spec" ]]; then
            spec=1
            continue
        fi
        _ggpi_args+=( "$arg" )
    done
    set -- ${_ggpi_args[@]+"${_ggpi_args[@]}"}

    if [[ -z "$1" ]]; then
        echo "Usage: ggpi <short> [model] [--spec] [--] [messages...]"
        echo
        ggpi_list
        echo
        echo "Examples:"
        echo "  ggpi m2-dsv4                  # m2 machine, DeepSeek"
        echo "  ggpi rtx-qwen4 'fix the bug'  # rtx machine, Qwen, with a prompt"
        echo "  ggpi dgx-glm agent-glm 'hi'   # model id is optional before the prompt"
        echo "  ggpi m5 --spec                # planning session, then dictate the task"
        return 1
    fi

    # find the provider matching the short name
    provider=""; models=""
    for entry in "${GGPI_PROVIDERS[@]}"; do
        short=${entry%%:*}
        if [[ "$short" == "$1" ]]; then
            rest=${entry#*:}
            provider=${rest%%:*}
            rest=${rest#*:}
            models=${rest%%:*}
            model_name=${rest#*:}
            break
        fi
    done

    if [[ -z "$provider" ]]; then
        echo "ggpi: unknown provider '$1'" >&2
        echo >&2
        ggpi_list >&2
        return 1
    fi

    # drop the short name
    shift

    # the next arg is a model only if it's valid for this provider; otherwise
    # it (and the rest) are the prompt. default to the provider's first model.
    model=""
    if [[ -n "${1:-}" && ",${models}," == *",${1},"* ]]; then
        model=$1
        shift
    fi
    [[ -z "$model" ]] && model=$(echo "$models" | cut -d',' -f1)

    echo "ggpi: $provider: $model_name" >&2

    # --spec: append the planning prompt and pin the task file for this session
    if (( spec )); then
        spec_prompt=${GGPI_SPEC_PROMPT:-$HOME/.pi/agent/SPEC.md}
        if [[ ! -f "$spec_prompt" ]]; then
            echo "ggpi: spec: no prompt found at $spec_prompt" >&2
            return 1
        fi

        # no task description means no slug - the agent names the task file in the session
        spec_slug=$(_ggpi_slug "$*")
        mkdir -p .pi
        spec_args=( --append-system-prompt "$spec_prompt" )
        if [[ -n "$spec_slug" ]]; then
            export GGPI_TASK_FILE="$PWD/.pi/task-${spec_slug}.md"
            spec_args+=( --name "spec:$spec_slug" )
            echo "ggpi: spec: ${spec_prompt#$HOME/} -> ${GGPI_TASK_FILE#$HOME/}" >&2
        else
            export GGPI_TASK_FILE=
            echo "ggpi: spec: ${spec_prompt#$HOME/} -> .pi/task-<slug>.md, named in session" >&2
        fi
    fi

    # if running under herdr, name the current tab after the provider/model
    if [[ -n "$HERDR_ENV" ]]; then
        tab_id=$(herdr pane current 2>/dev/null | jq -r '.result.pane.tab_id // empty')
        if [[ -n "$tab_id" ]]; then
            herdr tab rename "$tab_id" "${spec:+spec:}$provider:$model_name" 2>/dev/null
        fi
    fi

    export PI_MODEL_NAME="$model_name"

    pi --offline -nc --provider "$provider" --model "$model" ${spec_args[@]+"${spec_args[@]}"} "$@"
}

# show most recent branches
ggbr() {
    git for-each-ref --sort=-committerdate --format='%(refname:short) %(committerdate:relative)' refs/remotes/origin/ | grep origin/gg | head -n 16
    printf "\n"
    git for-each-ref --sort=-committerdate --format='%(refname:short) %(committerdate:relative)' refs/heads/ | grep gg/ | head -n 16
}
