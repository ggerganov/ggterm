#!/bin/bash

# ls colors
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

export EDITOR=vim

# kitten
alias icat="kitty +kitten icat"
#alias diff="kitty +kitten diff"
alias gd="git difftool --no-symlinks --dir-diff"

# home bin
if [ -d ~/bin ]; then
    export PATH=~/bin:$PATH
fi

export HISTCONTROL=erasedups:ignorespace
export HISTSIZE=10000000
export HISTFILESIZE=100000000

PROMPT_COMMAND='printf "\033]0;${PWD}\007"'
#PROMPT_COMMAND='echo "${PWD/#$HOME/~}"'
#PROMPT_COMMAND='echo "\033]0;${PWD/#$HOME/~}\007"'
#PROMPT_COMMAND="printf \"\033]0; $(pwd) \a\"; $PROMPT_COMMAND"

#shopt -s histappend
#PROMPT_COMMAND="history -a; history -r; $PROMPT_COMMAND"

alias mc="$(which mc) -u"

#bindkey "\e[1;3C" forward-word
#bindkey "\e[1;3D" backward-word

source ~/.myenv.local

alias llama-mac="pgrep -f 'ssh -fNL 8013:localhost:8013 ggerganov@gg-studio' || ssh -fNL 8013:localhost:8013 ggerganov@gg-studio"
alias llama-dgx="pgrep -f 'ssh -fNL 8023:localhost:8023 ggml@gg-spark-0'     || ssh -fNL 8023:localhost:8023 ggml@gg-spark-0"

pr2wt() {
    if [[ $# -gt 1 ]]; then
        #./scripts/pr2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        if [[ "$2" == "build" ]]; then
            ./scripts/pr2wt.sh "$1" "cmake -B build -DLLAMA_BUILD_UI=OFF && cmake --build build -j && cd build && bash -l"
        elif [[ "$2" == "debug" ]]; then
            ./scripts/pr2wt.sh "$1" "cmake -B build-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build-debug -j && cd build-debug && bash -l"
        else
            ./scripts/pr2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        fi
    else
        ./scripts/pr2wt.sh "$1" "bash -l"
    fi
}

wc2wt() {
    if [[ $# -gt 1 ]]; then
        #./scripts/wc2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        if [[ "$2" == "build" ]]; then
            ./scripts/wc2wt.sh "$1" "cmake -B build -DLLAMA_BUILD_UI=OFF && cmake --build build -j && cd build && bash -l"
        elif [[ "$2" == "debug" ]]; then
            ./scripts/wc2wt.sh "$1" "cmake -B build-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build-debug -j && cd build-debug && bash -l"
        else
            ./scripts/wc2wt.sh "$1" "cmake -B build && cmake --build build -j && $2"
        fi
    else
        ./scripts/wc2wt.sh "$1" "bash -l"
    fi
}

# ggpi: run pi against a local llama provider
# usage: ggpi <short> [model] [--] [messages...]
# no args: list available options
# format: short:provider:model1,model2,...
GGPI_PROVIDERS=(
    "m2:llama-mac-m2:agent-qwen3.8,agent-dsv4"
    "m5:llama-mac-m5:agent-dsv4"
    "dgx:llama-dgx:agent-dsv4"
    "rtx:llama-rtx:agent-qwen3.8"
    "strix:llama-strix:agent-dsv4"
)

ggpi_list() {
    printf "%-8s %-16s %s\n" "SHORT" "PROVIDER" "MODELS"
    local entry short rest provider models
    for entry in "${GGPI_PROVIDERS[@]}"; do
        short=${entry%%:*}
        rest=${entry#*:}
        provider=${rest%%:*}
        models=${rest#*:}
        printf "%-8s %-16s %s\n" "$short" "$provider" "$models"
    done
}

ggpi() {
    local entry short rest provider models model tab_id

    if [[ -z "$1" ]]; then
        echo "Usage: ggpi <short> [model] [--] [messages...]"
        echo
        ggpi_list
        echo
        echo "Examples:"
        echo "  ggpi m2              # m2, first (default) model"
        echo "  ggpi m2 agent-dsv4   # m2 with a specific model"
        echo "  ggpi rtx 'fix the bug'  # rtx (default model) with a prompt"
        return 1
    fi

    # find the provider matching the short name
    provider=""; models=""
    for entry in "${GGPI_PROVIDERS[@]}"; do
        short=${entry%%:*}
        if [[ "$short" == "$1" ]]; then
            rest=${entry#*:}
            provider=${rest%%:*}
            models=${rest#*:}
            break
        fi
    done

    if [[ -z "$provider" ]]; then
        echo "ggpi: unknown provider '$1'" >&2
        echo >&2
        ggpi_list >&2
        return 1
    fi

    # drop the short name
    shift

    # the next arg is a model only if it's valid for this provider; otherwise
    # it (and the rest) are the prompt. default to the provider's first model.
    model=""
    if [[ -n "${1:-}" && ",${models}," == *",${1},"* ]]; then
        model=$1
        shift
    fi
    [[ -z "$model" ]] && model=$(echo "$models" | cut -d',' -f1)

    # if running under herdr, name the current tab after the selected provider/model
    if [[ -n "$HERDR_ENV" ]]; then
        tab_id=$(herdr pane current 2>/dev/null | jq -r '.result.pane.tab_id // empty')
        if [[ -n "$tab_id" ]]; then
            herdr tab rename "$tab_id" "$provider:$model" 2>/dev/null
        fi
    fi

    pi --offline -nc --provider "$provider" --model "$model" "$@"
}

# show most recent branches
ggbr() {
    git for-each-ref --sort=-committerdate --format='%(refname:short) %(committerdate:relative)' refs/remotes/origin/ | grep origin/gg | head -n 16
    printf "\n"
    git for-each-ref --sort=-committerdate --format='%(refname:short) %(committerdate:relative)' refs/heads/ | grep gg/ | head -n 16
}
